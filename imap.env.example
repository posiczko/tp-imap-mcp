# Copy to ~/.config/tp-imap-mcp/imap.env (chmod 600) and adjust; a git-ignored
# imap.env in the repository root also works. Values may be op:// references;
# `op run --env-file <path> -- ...` resolves them before the process starts.
#
# Each name in IMAP_ACCOUNTS gets its own IMAP_<NAME>_* block (name uppercased)
# and is the `account` argument of the MCP tools. IMAP_<NAME>_AUTH selects the
# login method per account: password (default) or oauth2.
IMAP_ACCOUNTS=tetra,gmail,work

# Plain IMAP server, password login.
IMAP_TETRA_HOST=op://Tetrapyloctomy/IMAP Tetrapyloctomy/host
IMAP_TETRA_LOGIN=op://Tetrapyloctomy/IMAP Tetrapyloctomy/username
IMAP_TETRA_PASSWORD=op://Tetrapyloctomy/IMAP Tetrapyloctomy/password
# IMAP_TETRA_PORT=993
# IMAP_TETRA_READONLY=1
# IMAP_TETRA_DRAFTS=Drafts
# IMAP_TETRA_FILTERS=password_reset,one_time_codes

# Personal Gmail with an app password (https://myaccount.google.com/apppasswords).
IMAP_GMAIL_HOST=imap.gmail.com
IMAP_GMAIL_LOGIN=you@gmail.com
IMAP_GMAIL_PASSWORD=op://Private/Gmail App Password/password
IMAP_GMAIL_DRAFTS=[Gmail]/Drafts

# Work Google account with XOAUTH2 (docs/runbooks/gmail-xoauth2.md).
# No IMAP_WORK_PASSWORD for an OAuth account.
IMAP_WORK_HOST=imap.gmail.com
IMAP_WORK_LOGIN=you@work.example
IMAP_WORK_AUTH=oauth2
IMAP_WORK_OAUTH_PROVIDER=google
IMAP_WORK_OAUTH_CLIENT_ID=op://Work/Work Gmail OAuth/client id
IMAP_WORK_OAUTH_CLIENT_SECRET=op://Work/Work Gmail OAuth/client secret
# Required to serve; uncomment after `tp_imap_mcp auth work` and storing the
# printed token (`op run` fails on references to fields that do not exist yet):
# IMAP_WORK_OAUTH_REFRESH_TOKEN=op://Work/Work Gmail OAuth/refresh token
IMAP_WORK_DRAFTS=[Gmail]/Drafts
IMAP_WORK_READONLY=1
# Microsoft 365 instead: IMAP_<NAME>_HOST=outlook.office365.com,
# IMAP_<NAME>_OAUTH_PROVIDER=microsoft, IMAP_<NAME>_OAUTH_TENANT=<tenant or common>.

# Cache (ADRs 0013-0015): $XDG_CACHE_HOME/tp-imap-mcp or ~/.cache/tp-imap-mcp
# TP_IMAP_MCP_CACHE=0            # disable caching
# TP_IMAP_MCP_MAILBOX_TTL=3600   # seconds a cached mailbox list stays fresh

# TLS (ADR 0016): server certificates are verified against this PEM bundle.
# TP_IMAP_MCP_CA_FILE=/opt/homebrew/etc/ca-certificates/cert.pem
